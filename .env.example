# Copy to .env.local and fill in values. NEVER commit .env or .env.local.
# This template must only ever contain placeholders.

# Login for the whole app. Required in production: without both values, every
# request is refused, and the password must be at least 12 characters.
# Leave unset for local development.
APP_USERNAME=
APP_PASSWORD=

# Prototype demos only: exactly `true` opens a production deployment to anyone with
# the link, as long as both values above are unset. A configured login always wins.
# Leave unset for real use.
PUBLIC_DEMO=
