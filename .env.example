# Copy to .env.local and fill in values. NEVER commit .env or .env.local.
# Each developer fetches their own keys; we do not share keys via git, Slack, or screenshots.
# This template must only ever contain PLACEHOLDERS — never real keys.

# --- Google Maps Platform (Solar API + Photorealistic 3D Tiles + Geocoding + Places) ---
# https://console.cloud.google.com → enable Solar API + Map Tiles API + Geocoding + Places
# The app reads BOTH of these (server-side and client-side); they can be the same key.
GOOGLE_MAPS_API_KEY=AIza-your-server-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza-your-client-key

# --- Google Gemini (via AI Studio) ---
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key

# --- Tavily (live residential/commercial tariff lookup; optional) ---
# Sign up at https://www.tavily.com or https://app.tavily.com
TAVILY_API_KEY=tvly-your-key

# --- Vercel deploy hook (optional; CI/CD only) ---
VERCEL_DEPLOY_HOOK_URL=

# --- App config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Run fully offline at $0 (no keys needed) ---
# MOCK_MODE=true
# NEXT_PUBLIC_MOCK_MODE=true
